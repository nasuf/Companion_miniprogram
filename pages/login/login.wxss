.login {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background: linear-gradient(180deg, #eef2f7 0%, #e7edf5 52%, #e6effb 100%);
}

/* Soft aura blobs (static, matching the Flutter login backdrop) */
.orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(60rpx);
  opacity: 0.55;
}
.orb-a {
  width: 520rpx;
  height: 600rpx;
  right: -180rpx;
  top: 60rpx;
  background: radial-gradient(circle at 40% 40%, rgba(88, 168, 255, 0.5), transparent 70%);
}
.orb-b {
  width: 600rpx;
  height: 520rpx;
  left: -220rpx;
  bottom: 40rpx;
  background: radial-gradient(circle at 50% 50%, rgba(255, 214, 184, 0.45), transparent 70%);
}

.content {
  position: relative;
  z-index: 1;
  padding: 120rpx 56rpx 60rpx;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  box-sizing: border-box;
}

.brand {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
/* Flutter 端同款 logo 图 (assets/prototype/logo.png)，圆角+柔影与 App 一致 */
.brand-logo {
  width: 112rpx;
  height: 112rpx;
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 48rpx rgba(31, 111, 255, 0.2), 0 1rpx 0 #ffffff;
}
.brand-name {
  font-size: 34rpx;
  font-weight: 800;
  color: #1f4fb0;
}
.brand-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(24, 31, 38, 0.48);
}

.hero {
  margin-top: 64rpx;
}
.hero-title {
  font-size: 64rpx;
  font-weight: 800;
  color: #181f26;
  line-height: 1.1;
}
.hero-sub {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: rgba(24, 31, 38, 0.54);
  line-height: 1.6;
}

.card {
  margin-top: auto;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 28rpx;
  padding: 28rpx 28rpx 32rpx;
  box-shadow: 0 20rpx 60rpx rgba(49, 91, 136, 0.12);
}

.seg {
  display: flex;
  background: #f0f2f5;
  border-radius: 999rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
}
.seg-item {
  flex: 1;
  text-align: center;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #9aa0a8;
  border-radius: 999rpx;
}
.seg-item.on {
  background: #ffffff;
  color: #1c1c1e;
  box-shadow: 0 4rpx 14rpx rgba(49, 91, 136, 0.12);
}

.field {
  background: #f5f6f8;
  border-radius: 16rpx;
  padding: 0 26rpx;
  margin-bottom: 18rpx;
}
.field-input {
  height: 92rpx;
  font-size: 30rpx;
}

.submit {
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  border-radius: 18rpx;
  margin-top: 10rpx;
  background: linear-gradient(90deg, #1f6fff, #2f8bff);
  box-shadow: 0 14rpx 34rpx rgba(31, 111, 255, 0.28);
}
.submit.busy {
  opacity: 0.7;
}

.divider {
  display: flex;
  align-items: center;
  margin: 40rpx 0 28rpx;
}
.line {
  flex: 1;
  height: 1rpx;
  background: rgba(24, 31, 38, 0.12);
}
.or {
  padding: 0 24rpx;
  font-size: 24rpx;
  font-weight: 800;
  color: rgba(24, 31, 38, 0.4);
}

.social {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
}
.wechat-orb {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #07c160;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(255, 255, 255, 0.7);
  box-shadow: 0 10rpx 24rpx rgba(35, 48, 64, 0.18);
}
.wechat-loading {
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 700;
}

/* ── CSS-drawn WeChat logo: big bubble (top-left, tail down-left) +
      small bubble (bottom-right, tail down-right), eyes in brand green ── */
.wx-logo {
  position: relative;
  width: 58rpx;
  height: 50rpx;
}
.wx-bubble-big {
  position: absolute;
  left: 0;
  top: 0;
  width: 42rpx;
  height: 34rpx;
  background: #ffffff;
  border-radius: 50% 50% 48% 48%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}
.wx-bubble-big::after {
  content: "";
  position: absolute;
  left: 6rpx;
  bottom: -6rpx;
  width: 0;
  height: 0;
  border-left: 10rpx solid #ffffff;
  border-bottom: 10rpx solid transparent;
}
.wx-bubble-small {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 30rpx;
  height: 25rpx;
  background: #ffffff;
  border: 4rpx solid #07c160; /* green gap where it overlaps the big bubble */
  border-radius: 50% 50% 48% 48%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  z-index: 1;
}
.wx-bubble-small::after {
  content: "";
  position: absolute;
  right: 4rpx;
  bottom: -5rpx;
  width: 0;
  height: 0;
  border-right: 8rpx solid #ffffff;
  border-bottom: 8rpx solid transparent;
}
.wx-eye {
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: #07c160;
}
.wx-eye-sm {
  width: 5rpx;
  height: 5rpx;
}
.social-label {
  font-size: 26rpx;
  color: rgba(24, 31, 38, 0.6);
}

.privacy {
  margin-top: 40rpx;
  text-align: center;
  font-size: 22rpx;
  color: rgba(24, 31, 38, 0.46);
}
